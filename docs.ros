#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn
  (ros:ensure-asdf)
  (asdf:load-asd (merge-pathnames "meet-dapla-deploy.asd" *load-pathname*))
  #+quicklisp
  (let ((needed '(:40ants-doc :40ants-doc-full)))
    (unless (every #'ql-dist:find-system (mapcar #'string-downcase needed))
      (ql-dist:install-dist "http://dist.ultralisp.org/" :prompt nil))
    (ql:quickload (cons :meet-dapla-deploy/docs needed) :silent t)))

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(defpackage :ros.script.docs.3167498364
  (:use :cl :40ants-doc :meet-dapla-deploy/docs))
(in-package :ros.script.docs.3167498364)

(defun main (&rest argv)
  (declare (ignore argv))
  (ensure-directories-exist "build/")
  (let ((markdown (40ants-doc-full/builder:render-to-string
                    (symbol-value (find-symbol "@MEET-DAPLA-DEPLOY" "MEET-DAPLA-DEPLOY/DOCS"))
                    :format :markdown)))
    (with-open-file (out "build/meet-dapla-deploy.md"
                         :direction :output :if-exists :supersede)
      (write-string markdown out))
    (format t "Wrote build/meet-dapla-deploy.md~%")))
;;; vim: set ft=lisp lisp:
